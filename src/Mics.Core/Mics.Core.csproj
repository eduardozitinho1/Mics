<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mics</RootNamespace>
    <AssemblyName>Mics.Core</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mics.Core</PackageId>
    <Version>0.4.0</Version>
    <Authors>Eduardo Zitinho</Authors>
    <Description>Fluent sound composition library. Build tones, melodies, chords, and multi-voice songs from plain C#.</Description>
    <PackageTags>music;audio;sound;compose;wav;synthesis;sonification</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/eduardozitinho1/Mics</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
