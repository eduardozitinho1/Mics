<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mics</RootNamespace>
    <AssemblyName>Mics.CodeAnalysis</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mics.CodeAnalysis</PackageId>
    <Version>1.0.0</Version>
    <Authors>Eduardo Zitinho</Authors>
    <Description>Turn C# source code into music. Roslyn-based parser and mapper for the Mics ecosystem.</Description>
    <PackageTags>music;audio;sonification;code;csharp;roslyn</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/eduardozitinho1/Mics</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mics.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Mics.Core/Mics.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
